# ─────────────────────────────────────────────────────────────
# Meta (Facebook) integration
# ─────────────────────────────────────────────────────────────
# Most of these can also be set at runtime from the admin Marketing dashboard
# (stored in the meta_settings table). Env vars act as defaults / fallbacks.

# Pixel / Dataset ID — enables the browser Pixel AND is the dataset CAPI posts to.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# Conversions API (server-to-server) access token (system user token). Secret —
# never exposed to the browser. Required for CAPI events to actually send.
META_CAPI_ACCESS_TOKEN=

# Commerce catalog id the product feed is attached to (informational in the UI).
META_CATALOG_ID=

# Store/brand name used as <g:brand> in the catalog feed.
META_BRAND_NAME=AURA Store

# Absolute public origin, used to build absolute links in the catalog feed and
# the feed URL shown in the dashboard. If unset, it is derived from the request.
NEXT_PUBLIC_SITE_URL=

# Optional: Meta "Test Events" code to route events to the Test Events tool.
META_TEST_EVENT_CODE=

# Optional: shared secret. If set, the catalog feed requires ?token=<value>.
META_FEED_TOKEN=

# Optional: override the Graph API base (used in tests to point at a mock).
# META_GRAPH_API_URL=https://graph.facebook.com/v21.0

# ─── Facebook Login for Business / Meta Business Extension (one-click connect) ──
# These require a registered Meta App that has passed App Review, plus HTTPS.
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_MBE_CONFIG_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=

# ─────────────────────────────────────────────────────────────
# Email / lifecycle (Phase 5)
# ─────────────────────────────────────────────────────────────
# Without these, emails are logged to the `emails` outbox table (no external
# send). Set a Resend API key to actually deliver welcome/order/abandoned emails.
RESEND_API_KEY=
EMAIL_FROM=AURA Store <onboarding@resend.dev>
